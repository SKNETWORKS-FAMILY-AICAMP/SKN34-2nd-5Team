# 로컬 기본값은 auth_service/auth_service.db(SQLite)입니다.
# AWS에서는 기존 yelp_data가 아닌 별도 DB와 전용 계정을 사용하세요.
AUTH_DATABASE_URL=mysql+pymysql://auth_app:URL_ENCODED_PASSWORD@DB_HOST/reviewer_retention_auth?charset=utf8mb4

# HTTPS 배포에서는 반드시 true로 설정합니다.
AUTH_ENV=production
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=8

# 승인된 일반 사용자가 로그인한 뒤 이동할 React 주소입니다.
AUTH_AFTER_LOGIN_URL=/

# React와 인증 API의 origin이 다를 때만 쉼표로 구분해 지정합니다.
# 같은 도메인에서 Nginx로 /auth를 연결하면 비워 둡니다.
AUTH_ALLOWED_ORIGINS=
